        "lower_third": 0.0
      },
      "list": {
        "scrim_right": 0.12,
        "scrim_left": 0.1,
        "card": 0.08,
        "band_top": 0.04,
        "band_bottom": 0.04,
        "lower_third": 0.0
      },
      "stat": {
        "scrim_right": 0.12,
        "scrim_left": 0.1,
        "card": 0.08,
        "band_top": 0.04,
        "band_bottom": 0.04,
        "lower_third": 0.0
      },
      "barchart": {
        "card": 0.1,
        "scrim_right": 0.08,
        "band_top": 0.05,
        "lower_third": 0.0
      },
      "compare": {
        "card": 0.1,
        "scrim_right": 0.08,
        "band_top": 0.05,
        "lower_third": 0.0
      },
      "quote": {
        "band_top": 0.08,
        "scrim_right": 0.1,
        "card": 0.05,
        "lower_third": 0.0
