{
  "schema": "semotion.policy/1",
  "name": "smart_balanced",
  "version": "1.0.0",
  "meta": {
    "intent": "Editorial, restrained motion graphics for talking-head video. Type first, one accent sampled from the footage, compose beside the silhouette, never over the person.",
    "provenance": [
      "Material Design motion: easing/duration ranges for UI (transform 200-300 ms, fade 150-200 ms) https://m3.material.io/styles/motion/easing-and-duration",
      "IBM Carbon motion: productive vs expressive durations; standard easing https://carbondesignsystem.com/elements/motion/overview/",
      "Apple HIG motion: purposeful, optional, no gratuitous animation https://developer.apple.com/design/human-interface-guidelines/motion",
      "BBC Subtitle Guidelines: 2 lines, reading speed, safe areas https://www.bbc.co.uk/accessibility/forproducts/guides/subtitles/",
      "Netflix Timed Text Style Guide: line length, minimum duration, bottom safe area https://partnerhelp.netflixstudios.com/hc/en-us/articles/215758617",
      "WCAG 2.2 SC 1.4.3 / 1.4.11: text contrast 4.5:1 https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
      "movis (keyframe/easing animation engine, draft quality, caching) https://github.com/rezoo/movis",
      "clipify (host-agent semantic moment selection, word-by-word captions) https://github.com/louisedesdeleer/clipify",
      "KazKozDev/auto-vertical-reframe (subject tracking with dead zone + motion lead) https://github.com/KazKozDev/auto-vertical-reframe",
      "WhisperX (phoneme forced alignment + VAD chunking) https://github.com/m-bain/whisperX"
    ],
    "rule": "Every number here is a *default*, not a law. A model (or a human) may override per project; the pipeline records which policy produced the render."
  },
  "budget": {
    "max_elements_per_10s": 4,
    "min_gap_s": 0.85,
    "max_coverage": 0.58,
    "hold_s": 0.45,
    "min_dwell_s": 1.35,
    "caption_band": 0.14
  },
  "layout": {
    "margin_ratio": 0.03,
    "min_margin_px": 48,
    "min_col_ratio": 0.19,
    "min_band_ratio": 0.115,
    "allow_torso": true,
    "text_conf_min": 0.5,
    "type_band": [
      0.18,
      0.74
    ],
    "treatment_pref": {
      "keyword": {
        "band_top": 0.1,
        "scrim_right": 0.12,
        "scrim_left": 0.1,
        "band_bottom": 0.08,
        "card": 0.04,
