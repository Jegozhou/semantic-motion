    "scrim": {
      "alpha": 0.86,
      "ramp_soft_px": 46,
      "vertical_falloff": 0.7
    }
  },
  "type": {
    "reference": {
      "min_height": 640,
      "width_factor": 0.62
    },
    "ratio": {
      "display": 0.078,
      "title": 0.058,
      "body": 0.03,
      "meta": 0.021,
      "stat": 0.15,
      "stat_unit": 0.052
